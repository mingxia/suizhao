{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "suizhao",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "suizhao-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "suizhao-photos" }],
  "vars": { "BETTER_AUTH_URL": "https://example.com" }
}
